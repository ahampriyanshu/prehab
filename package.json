{
  "name": "prehab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "build:pages": "next build --webpack",
    "check:pages": "node scripts/check-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "deploy": "gh workflow run deploy.yml --repo ahampriyanshu/prehab --ref main"
  },
  "dependencies": {
